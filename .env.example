# =============================================================================
# billet-studio environment configuration
# =============================================================================
# NEVER commit a filled-in copy - only this example file.
#
# Which copy you need depends on how you run the backend:
#
#   .env.local        backend started from the IDE or mvnw - Spring imports it from the repo root
#                     (spring.config.import in application.yml)
#   .env.production   deployed stack
#
# The file is read as a .properties file: a line you DELETE falls back to the default in
# application.yml, but a line left EMPTY sets an empty string. Only leave a value empty where
# empty is meant (e.g. DATABASE_PASSWORD for a stock XAMPP root, MAIL_USERNAME without auth).
#
# The BROWSER cannot read this file. Frontend runtime values reach it through window.__env in
# billet-studio-frontend/public/env.js (an empty placeholder locally, replaced per deployment).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (the schema is created by YOU from sql/, see sql/README.md)
# -----------------------------------------------------------------------------
# serverTimezone only tells the driver what to assume; stored DATETIMEs are UTC by contract.
DATABASE_URL=jdbc:mysql://localhost:3306/db_billet_studio?useSSL=false&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# -----------------------------------------------------------------------------
# JWT authentication
# -----------------------------------------------------------------------------
# HS512 needs at least 64 bytes. Generate one: openssl rand -hex 32 (64 hex chars).
JWT_SECRET=local-dev-only-jwt-secret-replace-with-output-of-openssl-rand-hex-32
# Access token lifetime (15 min). The session itself is a tbl_auth_sessions row with its own,
# longer deadlines, renewed silently via /v1/auth/refresh.
JWT_EXPIRATION_MS=900000
# true = refuse to boot on a blank, short or in-repo default secret, and on the in-repo ROOT_EMAIL /
# ROOT_PASSWORD placeholders. Always true in production.
ENFORCE_STRONG_SECRETS=false
# Browsers accept Secure cookies from http://localhost, so true also works locally. Set false only
# when testing over plain http from another host name or a LAN IP.
APP_AUTH_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Root / break-glass admin (bootstrapped by the backend at startup, see sql/README.md)
# -----------------------------------------------------------------------------
# Required in production. Use a long random password: openssl rand -base64 24
ROOT_EMAIL=root@local.dev
ROOT_PASSWORD=change-me-local-root-password
ROOT_NAME=Root

# -----------------------------------------------------------------------------
# URLs / CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Base for links the backend writes into mails (e.g. the password-reset link).
FRONTEND_URL=http://localhost:4200
# Base that tbl_models.file_path / preview_path (e.g. models/<slug>.v1.glb) are resolved against,
# with trailing slash. Today the files ship with the Angular app (public/models/). Moving them to
# the backend server (README "Modelle vom Backend ausliefern"; no SQL):
#   1. copy billet-studio-frontend/public/models/** into MODELS_DIRECTORY
#   2. MODELS_DIRECTORY=/srv/billet-studio/models   (absolute; the folder that holds the .glb files)
#   3. MODELS_BASE_URL=https://<api-host>/files/    (models/x.v1.glb -> https://<api-host>/files/models/x.v1.glb)
MODELS_BASE_URL=http://localhost:4200/
# Empty = the backend serves no model files (GET /files/models/** answers 404).
MODELS_DIRECTORY=

# -----------------------------------------------------------------------------
# Billet assistant (docs/assist.md)
# -----------------------------------------------------------------------------
# true = a local Ollama (ASSIST_URL, model ASSIST_MODEL, pulled beforehand) answers the assistant on the
# home page and in the template gallery; false = the assistant is not shown. Ollama has no
# authentication: keep ASSIST_URL reachable from this backend only.
ASSIST_ENABLED=false

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
# false = nothing is sent; mails are logged instead. The password-reset link is only logged while
# ENFORCE_STRONG_SECRETS=false (dev); in production it is never logged and startup logs an ERROR.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender of all outgoing mails / support address shown in mail footers.
FROM_EMAIL=noreply@example.com
CONTACT_EMAIL=support@example.com
# Logo in the mail header: a public absolute URL (mail clients cannot load localhost).
# Empty = mails render without a logo.
LOGO_URL=

# -----------------------------------------------------------------------------
# Files
# -----------------------------------------------------------------------------
# Relative paths resolve against the directory mvnw runs in (billet-studio-rest-service/).
UPLOAD_DIRECTORY=./uploads
LOG_DIRECTORY=./logs
# WebP/AVIF avatar uploads are decoded by the libwebp/libavif CLI tools. On Windows point these at
# the .exe files; without them such uploads answer INVALID_FILE_TYPE (jpg/png/gif/bmp still work).
# UPLOAD_DWEBP=dwebp
# UPLOAD_AVIFDEC=avifdec

# -----------------------------------------------------------------------------
# Limits / operations
# -----------------------------------------------------------------------------
# Max billets per account (BILLET_LIMIT_REACHED beyond it).
BILLET_MAX_PER_USER=50
# Only the e2e suite turns this off. Never false in production.
RATE_LIMIT_ENABLED=true
# Swagger UI + /v3/api-docs. false in production.
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# Optional - commented out = the application.yml default applies
# -----------------------------------------------------------------------------
# SERVER_PORT=8080
# JPA_SHOW_SQL=true
# MAIL_DEBUG=false
# Registrations per client IP within the window.
# REGISTER_RATE_LIMIT=3
# REGISTER_RATE_LIMIT_WINDOW=7d
# Upper bound for one serialized billet document, in bytes.
# BILLET_MAX_DOCUMENT_BYTES=262144
# The billet assistant's model server and model, how long the model stays in memory, how long one
# answer and the model load may take, loading at startup, and questions per client IP within the window.
# ASSIST_URL=http://127.0.0.1:11434
# ASSIST_MODEL=qwen2.5:14b
# ASSIST_KEEP_ALIVE=1h
# ASSIST_TIMEOUT=20s
# ASSIST_LOAD_TIMEOUT=120s
# ASSIST_WARM_UP=false
# ASSIST_RATE_LIMIT=20
# ASSIST_RATE_LIMIT_WINDOW=10m
