{
  "name": "billet-studio-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "version:gen": "node scripts/generate-version.mjs",
    "themes:gen": "node scripts/generate-themes.mjs --table",
    "prestart": "node scripts/generate-version.mjs && node scripts/generate-themes.mjs",
    "prebuild": "node scripts/generate-version.mjs && node scripts/generate-themes.mjs",
    "pretest": "node scripts/generate-version.mjs && node scripts/generate-themes.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format:html": "prettier --write \"src/**/*.html\"",
    "format:html:check": "prettier --check \"src/**/*.html\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular",
          "singleAttributePerLine": true
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.4",
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ngx-translate/core": "^17.0.0",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "three": "^0.186.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.0.1",
    "@types/three": "^0.186.0",
    "fallow": "^3.16.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
