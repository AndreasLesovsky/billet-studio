{
  // index.html loads these from public/ by <script>/<link> (served at the site root), so no import
  // reaches them and fallow resolves the tags against src/. env.js is the deploy-time override,
  // theme-boot.js sets the site theme + data-mode before the first paint, fonts.css is asset-pipeline
  // output.
  "entry": ["public/env.js", "public/theme-boot.js", "public/fonts/fonts.css"],
  "ignoreUnresolvedImports": ["./env.js", "./theme-boot.js", "./fonts/fonts.css"],

  // Generated data: FONT_CATALOG feeds the editor's font picker; the renderer reads FONT_BY_ID.
  "ignoreFindings": ["src/app/billet/fonts/font-catalog.generated.ts"],

  // Class members fallow's static analysis cannot see as "used":
  // - whenReady: called through inject() in an app initializer
  //   (provideAppInitializer(() => inject(LanguageService).whenReady())).
  // - items: BreadcrumbService's trail, read through inject(BreadcrumbService).items.
  // - focus: the FormUiControl contract of Signal Forms custom controls (ThemePicker); [formField]
  //   calls it when the form focuses the field.
  "usedClassMembers": ["whenReady", "items", "focus"],

  // - DeactivationReason: the enum const of core/models, which mirrors the API contract as if
  //   generated by OpenAPI Generator; consumers use its type so far.
  // - frontendUrl: the origin of the share link (<frontendUrl>/b/<token>), used from the publish
  //   flow on; the environment keeps all deploy-time values in one place.
  "ignoreExports": [
    { "file": "src/app/core/models/deactivationReason.ts", "exports": ["DeactivationReason"] },
    { "file": "src/app/core/environments/environment.ts", "exports": ["frontendUrl"] },
  ],

  // bootstrap-icons ships only the font and its codepoint map, read by scripts/generate-icons.mjs and
  // referenced by url() from the generated _icons.generated.scss - there is never a TS import for
  // fallow to find.
  "ignoreDependencies": ["bootstrap-icons"],

  // Generated files (never edited by hand, see CLAUDE.md "Theme workflow"): the per-theme blocks and
  // the per-icon rules repeat by construction, and theme-boot.js is the generator's output. Import declaration blocks
  // are inherently similar across spec files; DTOs share their field blocks by contract.
  "duplicates": { "ignoreImports": true, "ignore": ["**/*.generated.*", "**/core/models/**"] },
  //
  // CRAP is estimated as if uncovered, and nothing covers build scripts (outside the ng test runner;
  // the theme generator is verified through its outputs by theme-contrast.spec.ts) or spec helpers.
  // There the ceiling is the one the default cyclomatic limit implies at zero coverage (20² + 20),
  // so the cyclomatic and cognitive limits still decide.
  "health": {
    "ignore": ["**/*.generated.*", "public/theme-boot.js"],
    "thresholdOverrides": [
      {
        "files": ["scripts/**", "src/**/*.spec.ts"],
        "maxCrap": 420,
        "reason": "No coverage exists for build scripts and spec helpers; complexity limits apply.",
      },
    ],
  },
}
