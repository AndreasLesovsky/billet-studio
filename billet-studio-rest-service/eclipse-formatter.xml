<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  The one source for Java formatting in this repository.

  Two consumers point at this file and must never diverge:
    - Maven:  spotless-maven-plugin, <java><eclipse><file>
    - VS Code: java.format.settings.url in .vscode/settings.json

  Taken over unchanged from CommerceX, so code ported from there formats identically. Keys that
  are absent fall back to the JDT defaults.
-->
<profiles version="23">
  <profile kind="CodeFormatterProfile" name="BilletStudio" version="23">

    <!-- Indentation: spaces, 4, matching .editorconfig [*.java]. -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.use_tabs_only_for_leading_indentations" value="false"/>

    <!--
      Continuation is ONE unit, so a wrapped line sits 4 further in and not 8; the owner finds the
      double indent harder to read.
    -->
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="1"/>
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer" value="1"/>

    <!-- 120 columns. -->
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="120"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.line_length" value="120"/>

    <!--
      The formatter does not pull hand written line breaks back together. This is the Java
      counterpart to wrapAttributes: preserve for HTML and the reason the result does not feel
      like Prettier.
    -->
    <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.join_lines_in_comments" value="false"/>

    <!-- Comments: reflow prose, but never touch a file header. -->
    <setting id="org.eclipse.jdt.core.formatter.comment.format_javadoc_comments" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.format_block_comments" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.format_line_comments" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.format_header" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.preserve_white_space_between_code_and_line_comments" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.indent_parameter_description" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.insert_new_line_before_root_tags" value="insert"/>

    <!-- Blank lines: keep what the author wrote, up to one. -->
    <setting id="org.eclipse.jdt.core.formatter.number_of_empty_lines_to_preserve" value="1"/>
    <setting id="org.eclipse.jdt.core.formatter.blank_lines_before_package" value="0"/>
    <setting id="org.eclipse.jdt.core.formatter.blank_lines_after_package" value="1"/>
    <setting id="org.eclipse.jdt.core.formatter.blank_lines_before_imports" value="1"/>
    <setting id="org.eclipse.jdt.core.formatter.blank_lines_after_imports" value="1"/>
    <!--
      Zero means "do not force one", not "remove them". number_of_empty_lines_to_preserve above
      keeps the blank lines the author wrote. Forcing 1 here would push a blank line between the
      paired getter and setter of every DTO, which is a restyling.
    -->
    <setting id="org.eclipse.jdt.core.formatter.blank_lines_before_method" value="0"/>
    <setting id="org.eclipse.jdt.core.formatter.blank_lines_before_field" value="0"/>
    <setting id="org.eclipse.jdt.core.formatter.blank_lines_before_first_class_body_declaration" value="0"/>

    <!-- Braces at the end of the line, the conventional Java shape this codebase already uses. -->
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_type_declaration" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_method_declaration" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_constructor_declaration" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_block" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_switch" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_anonymous_type_declaration" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_array_initializer" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_lambda_body" value="end_of_line"/>

    <!-- Never line up members in columns; that turns an unrelated rename into a wide diff. -->
    <setting id="org.eclipse.jdt.core.formatter.align_type_members_on_columns" value="false"/>

    <setting id="org.eclipse.jdt.core.formatter.indent_switchstatements_compare_to_switch" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.indent_switchstatements_compare_to_cases" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.indent_body_declarations_compare_to_type_header" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.indent_statements_compare_to_block" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.indent_statements_compare_to_body" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.indent_empty_lines" value="false"/>

    <!-- Matches insert_final_newline in .editorconfig. -->
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_at_end_of_file_if_missing" value="insert"/>

    <setting id="org.eclipse.jdt.core.formatter.keep_then_statement_on_same_line" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_else_statement_on_same_line" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.put_empty_statement_on_new_line" value="true"/>

    <!--
      Anything the author put on one line stays on one line. Without this the formatter expands
      every single line getter and setter in the DTOs into five lines, which is a restyling and
      not a normalisation. one_line_preserve is the same stance as join_wrapped_lines above:
      normalise the whitespace, leave the shape alone.
    -->
    <setting id="org.eclipse.jdt.core.formatter.keep_method_body_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_simple_getter_setter_on_one_line" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_empty_array_initializer_on_one_line" value="true"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_enum_declaration_on_one_line" value="one_line_preserve"/>
    <setting id="org.eclipse.jdt.core.formatter.keep_enum_constant_declaration_on_one_line" value="one_line_preserve"/>

    <!--
      Field annotations go on their own line. JDT offers insert or do not insert and no "preserve";
      own line is the JDT default and the conventional shape for JPA entities. Parameters and
      locals keep the default, which is inline, so a Spring controller signature stays readable.
    -->
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_after_annotation_on_field" value="insert"/>

  </profile>
</profiles>
