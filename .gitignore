############################################################
#  GLOBAL
############################################################

# System files
.DS_Store
Thumbs.db

# Logs (LOG_DIRECTORY defaults to ./logs, relative to where mvnw runs)
*.log
billet-studio-rest-service/logs/
npm-debug.log
yarn-error.log
pnpm-debug.log
libpeerconnection.log
testem.log

# Temp
*.tmp


############################################################
#  NODE / ANGULAR (frontend + tools/asset-pipeline)
############################################################

# Build output
dist/
tmp/
out-tsc/
bazel-out/

# Captured build/test stdout (e.g. `ng build > build_output.txt`)
build_*.txt
test_*.txt

# Auto-generated build stamp (regenerated by scripts/generate-version.mjs via prestart/prebuild/pretest)
billet-studio-frontend/src/app/core/version.ts

# Node modules (covers billet-studio-frontend/ and tools/asset-pipeline/)
node_modules/
tools/asset-pipeline/node_modules/

# Angular cache
.angular/

# Sass cache
.sass-cache/

# fallow analysis caches
.fallow/

# Misc
connect.lock
coverage/
typings/
__screenshots__/


############################################################
#  EDITORS / IDEs
############################################################

# JetBrains / IntelliJ / WebStorm
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.project
.classpath
.settings/

# Sublime
*.sublime-workspace

# Cloud9
.c9/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Claude Code local state and plans stay out of the repo (CLAUDE.md itself is tracked).
.claude/


############################################################
#  JAVA / SPRING BOOT
############################################################

# Maven / Gradle build output (the Maven wrapper files under .mvn/wrapper/ stay tracked)
target/
build/
out/


############################################################
#  UPLOADS (user avatars)
############################################################

uploads/


############################################################
#  LOCAL DB DUMPS (never commit - schema.sql, seeds and migrations/ stay tracked)
############################################################
db_billet_studio*.sql
sql/*backup*.sql
sql/*dump*.sql


############################################################
#  ENVIRONMENT
############################################################
# Environment files (never commit secrets!)
.env
.env.*
!.env.example


############################################################
#  E2E / PLAYWRIGHT (frontend e2e + asset-pipeline preview renderer) - run output only
############################################################
playwright-report/
test-results/
blob-report/
.playwright/
billet-studio-frontend/e2e/artifacts/
billet-studio-frontend/e2e/.auth/
