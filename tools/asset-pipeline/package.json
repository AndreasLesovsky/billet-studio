{
  "name": "billet-studio-asset-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generates the billet-studio model library (optimized GLBs, WebP previews, seed_models.sql) and the font set.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "models": "npm run models:optimize && npm run models:previews && npm run models:seed",
    "models:optimize": "node models/optimize-models.mjs",
    "models:previews": "node models/render-previews.mjs",
    "models:seed": "node models/generate-seed-models.mjs",
    "models:compare": "node models/render-previews.mjs --compare",
    "fonts": "node fonts/merge-fonts.mjs",
    "fonts:check": "node fonts/merge-fonts.mjs --check",
    "hero:capture": "node hero/capture-hero.mjs",
    "hero:gifts": "node hero/build-hero-gifts.mjs",
    "hero:compare": "node hero/compare-hero-gifts.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "meshoptimizer": "1.2.0",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "three": "0.186.0"
  }
}
